# --- Application ---
APP_ENV=production
DEBUG=false
APP_NAME=VIST LMS
INSTITUTE_TIMEZONE=Asia/Karachi

# --- Database ---
# On the VPS itself use localhost. From another PC use the server name and ssl=require.
# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/vist_lms
DATABASE_URL_SYNC=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/vist_lms
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Sign-in ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_to_a_random_string_of_at_least_48_characters
COOKIE_SECURE=true          # false only for local http:// testing
CORS_ORIGINS=https://your-domain.example

# --- Files ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage

# --- Online payments (leave empty until a bank/1LINK webhook is set up) ---
PAYMENT_WEBHOOK_SHARED_SECRET=
ENABLE_STUDENT_PAYMENT_SIMULATION=false

# --- SMS (leave SMS_PROVIDER_URL empty to only log messages) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_METHOD=GET
SMS_API_KEY=
SMS_SENDER_ID=
SMS_NUMBER_FORMAT=92

# 1Bill (1LINK) online fee payment. Leave off until the bank gives the biller username/password (docs/onebill.md).
ONE_BILL_ENABLED=0
ONE_BILL_USERNAME=
ONE_BILL_PASSWORD=
# Optional: only these addresses may call the 1Bill connection points (comma-separated, from the bank's document)
ONE_BILL_ALLOWED_IPS=
